---
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class="wpp-icon"
>
  <path
    d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>

<style>
  .wpp-icon {
    flex-shrink: 0;
    display: inline-block;
  }
</style>
